{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/remote/.twing/bin/twing-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/remote/.twing/bin/twing-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/remote/.twing/bin/twing-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/home/remote/.twing/bin/twing-hook"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/remote/.twing/bin/twing-hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/remote/.twing/bin/twing-hook"
          }
        ]
      }
    ]
  }
}
