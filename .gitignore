node_modules/
dist/
*.tsbuildinfo

# A repo's own .twing/twing.yml is committed -- it's shared team policy plus
# the coordinator's location (serverUrl), never a credential. Everything
# machine-local (daemon.sock, the multi-server auth-token config, the
# twing-hook binary) lives under ~/.twing/ instead -- the user's home
# directory, not inside any repo's working tree at all, so it can't be
# accidentally committed here. (Two now-dead entries used to live in this
# file claiming a repo-local .twing/daemon.sock and .twing/state.json --
# neither is real: the socket is always ~/.twing/daemon.sock per
# defaultSocketPath(), and nothing in this codebase ever creates a
# state.json anywhere.)
/hook/twing-hook
/hook/hook
openrouter_key.txt
simulator/.workspaces/
/twing-serve.log
/twing-serve.pid

# deploy/docker's real secrets file -- deploy/docker/.env.example is the
# committed template.
/deploy/docker/.env
# The GitHub App's downloaded private key. The *directory* stays committed
# (deploy/docker/secrets/.gitkeep) so docker-compose.yml's bind mount always
# has a real directory to mount even when no key has been placed there --
# confirmed live: bind-mounting a *file* path that doesn't exist on the host
# makes Docker silently create an empty, root-owned directory at that path
# instead (on both sides of the mount), which a non-root self-hoster who
# never configures the GitHub App then can't even remove without sudo.
# Mounting an always-real directory sidesteps that -- a missing key inside
# it is a clean, ordinary ENOENT the app already handles.
/deploy/docker/secrets/*
!/deploy/docker/secrets/.gitkeep
# deploy/docker's runtime data (SQLite db, bootstrap token) -- created by
# `mkdir -p data`, bind-mounted into the container, never committed.
/deploy/docker/data/

# Off-box copies of the production coordinator's SQLite database, pulled
# down before a risky upgrade. Real identity/design data for every project
# on the hosted coordinator -- never committed, and named here so a
# `git add -A` can't sweep one in.
/deploy/docker/backups-offbox/


# Editor swap/backup files. `.claude/` is committed now (it carries the
# bootstrap hook entries), so an editor left open on settings.json drops a
# .swp right beside a tracked file -- which is how one got committed.
*.swp
*.swo
*~

# Claude Code's own machine-local state inside the now-committed `.claude/`.
# `settings.json` there is shared team config (the twing bootstrap hook
# entries) and stays tracked; everything below is per-machine or per-session
# and must not be. These were only ever excluded via `.git/info/exclude`,
# which Claude Code writes locally and git never shares -- so this machine
# was protected and every teammate's clone was not. `settings.local.json` in
# particular is the documented per-machine override, and was covered by
# neither.
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/scheduled_tasks.json
/.claude/routines/.state/
/.claude/worktrees/
/.claude/checkpoints/
