# Automatic HTTPS (Let's Encrypt, HTTP-01/TLS-ALPN-01) -- Caddy is the only
# thing in this deployment that binds a host port, so it's the only piece
# that needs a real domain pointed at the box's public IP first.
{
	order rate_limit before reverse_proxy
}

coordination-server.twing.dev {
	# twing-monitor's list routes (/v1/designs, /v1/alignment-threads, ...)
	# return uncompressed JSON that's mostly repeated field names/text --
	# gzip/zstd shrinks them 5-10x. Found live, 2026-08-29, investigating
	# monitor UI load times: this response was going out with no
	# content-encoding at all even when the client advertised
	# `Accept-Encoding: gzip, br`, so every KB was crossing the wire raw.
	# `encode` is a built-in Caddy directive with a fixed position in the
	# default directive order (always before `reverse_proxy`), unlike
	# `rate_limit` above -- no `order` entry needed for this one.
	encode zstd gzip

	# Rate limiting on the abuse-prone, pre-authentication routes: the
	# break-glass bootstrap token, invite redemption, and GitHub-founding/
	# joining -- all reachable without a cached token, so all brute-forceable
	# by IP. Deliberately *not* applied to the rest of /v1/* (claims,
	# notices, designs, etc.) -- that's normal per-session traffic from
	# active daemons/hooks and shouldn't share a budget with the auth
	# surface. Per-remote-IP (not per-identity) since these routes are
	# reached by callers who don't have an identity yet.
	@auth_sensitive path /v1/admin/bootstrap /v1/invites/*/redeem /v1/projects/*/join-via-github
	rate_limit @auth_sensitive {
		zone auth_sensitive {
			key {remote_host}
			events 10
			window 1m
		}
	}

	# Public "observe twing getting built" demo (2026-08-28): unauthenticated
	# GET /v1/* traffic is genuinely zero-friction to hit once
	# TWING_PUBLIC_PROJECT_ID is set server-side (see app.ts's publicProjectId
	# doc comment) -- rate limit it the same way as @auth_sensitive above,
	# per-remote-IP since this traffic has no identity by construction. A
	# request that does carry an Authorization header (real daemons/hooks/
	# monitor sessions) never matches this and keeps its normal, unlimited
	# budget -- this only throttles the anonymous-viewer path.
	@public_get {
		method GET
		path /v1/*
		not header Authorization *
	}
	rate_limit @public_get {
		zone public_get {
			key {remote_host}
			events 60
			window 1m
		}
	}

	reverse_proxy twing-serve:8787
}

# twing-monitor dashboard -- a separate compose project (twing-monitor's own
# deploy/docker), reached over the shared external twing-edge network by
# service name. No rate limiting here: this serves a static bundle, not
# /v1/* API routes -- the coordinator's own auth-sensitive-route limiting
# above is unaffected and unrelated.
monitor.twing.dev {
	# Same finding as coordination-server.twing.dev above: the JS bundle
	# (~250KB) was also going out with no content-encoding at all. The
	# nginx image serving it (twing-monitor's own deploy/docker) has no
	# gzip config of its own, so this is the only place compressing it.
	encode zstd gzip
	reverse_proxy twing-monitor:80
}
