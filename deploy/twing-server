#!/usr/bin/env bash
set -euo pipefail

DEFAULT_INSTALL_DIR="${HOME}/.twing/server"
DEFAULT_IMAGE_REPOSITORY="ghcr.io/twing-dev/twing-server"

usage() {
  cat <<'EOF'
Usage:
  twing-server install (--domain <domain> | --insecure-http) [options]
  twing-server upgrade [options]
  twing-server status [--dir <path>]
  twing-server bootstrap-token [--dir <path>]
  twing-server stop [--dir <path>]
  twing-server uninstall [--dir <path>] [--purge-data]

Install options:
  --domain <domain>       Public HTTPS domain (required)
  --insecure-http          Direct private-network HTTP; no TLS proxy
  --mode auth|no-auth     Authentication mode (default: auth)
  --version <version>     Server image version (default: latest)
  --image <image>         Exact image reference; useful for local testing
  --dir <path>            Installation directory (default: ~/.twing/server)
  --port <port>           Public HTTPS port (default: 443)
  --http-port <port>      Public HTTP port for ACME challenges (default: 80)
  --bind <address>        HTTP bind address (default: 0.0.0.0)
  --monitor-url <url>     Published twing-monitor URL and browser CORS origin
  --no-pull               Use an image already present locally

Upgrade options:
  --version <version>     Version to install (default: latest)
  --image <image>         Exact image reference
  --dir <path>            Existing installation directory
  --monitor-url <url>     Update the published twing-monitor URL and CORS origin
  --no-pull               Use an image already present locally

Uninstall options:
  --dir <path>            Existing installation directory
  --purge-data            Also remove the persistent database, captures, and backups

Uninstall stops and removes the Compose deployment, wrapper, and generated
configuration. By default it leaves persistent data in <dir>/data, so a later
install to the same directory reuses it. --purge-data removes that data too.

The generated server.env file is preserved across upgrades. Put LLM,
GitHub App, CORS, and other server configuration there.
EOF
}

die() {
  echo "twing-server: $*" >&2
  exit 1
}

absolute_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PWD" "$1" ;;
  esac
}

read_setting() {
  local file="$1" key="$2"
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

write_stack_env() {
  local file="$1" image="$2" mode="$3" transport="$4" domain="$5" bind="$6" port="$7" http_port="$8" project="$9"
  local tmp="${file}.tmp"
  cat >"$tmp" <<EOF
TWING_SERVER_IMAGE=$image
TWING_AUTH_MODE=$mode
TWING_TRANSPORT=$transport
TWING_SERVER_DOMAIN=$domain
TWING_BIND_ADDRESS=$bind
TWING_PORT=$port
TWING_HTTP_PORT=$http_port
TWING_COMPOSE_PROJECT=$project
EOF
  mv "$tmp" "$file"
}

write_compose_file() {
  local file="$1" transport="$2" bind="$3" port="$4" http_port="$5"
  cat >"$file" <<'EOF'
name: ${TWING_COMPOSE_PROJECT}

services:
  server:
    image: ${TWING_SERVER_IMAGE}
    restart: unless-stopped
    env_file:
      - server.env
    environment:
      TWING_SERVE_DATA_DIR: /data
      TWING_HOST: 0.0.0.0
      TWING_AUTH_MODE: ${TWING_AUTH_MODE}
    volumes:
      - ./data:/data
      - ./secrets:/run/secrets:ro
EOF

  if [[ "$transport" == "http" ]]; then
    cat >>"$file" <<EOF
    ports:
      - "$bind:$port:8787"
EOF
  fi

  cat >>"$file" <<'EOF'
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:8787/v1/version').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 2s
      timeout: 2s
      retries: 30
      start_period: 2s
EOF

  if [[ "$transport" == "http" ]]; then
    return
  fi

  cat >>"$file" <<'EOF'
  caddy:
    image: caddy:2
    restart: unless-stopped
    ports:
      - "${TWING_HTTP_PORT}:80"
      - "${TWING_PORT}:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      server:
        condition: service_healthy

volumes:
  caddy-data:
  caddy-config:
EOF
}

write_caddyfile() {
  local file="$1" domain="$2"
  cat >"$file" <<EOF
$domain {
  reverse_proxy server:8787
}
EOF
}

write_server_env() {
  local file="$1"
  cat >"$file" <<'EOF'
# Preserved across `twing-server upgrade`.
# Configure one optional LLM provider and any browser/GitHub integration here.
# OPENROUTER_API_KEY=
# TWING_SERVE_CORS_ORIGINS=https://monitor.example.com
# TWING_GITHUB_APP_ID=
# TWING_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
EOF
  chmod 600 "$file"
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  printf '%s' "${value%"${value##*[![:space:]]}"}"
}

update_monitor_url() {
  local file="$1" monitor_url="$2" old_monitor_url existing_cors cors_origins="" origin trimmed_origin
  local -a origins=()
  local monitor_present=false

  [[ -n "$(trim "$monitor_url")" && "$monitor_url" != *$'\n'* && "$monitor_url" != *$'\r'* ]] || die "invalid monitor URL"
  old_monitor_url="$(read_setting "$file" TWING_MONITOR_URL)"
  existing_cors="$(read_setting "$file" TWING_SERVE_CORS_ORIGINS)"
  IFS=',' read -r -a origins <<<"$existing_cors"
  for origin in "${origins[@]-}"; do
    trimmed_origin="$(trim "$origin")"
    [[ -n "$trimmed_origin" ]] || continue
    # Replacing a monitor URL also removes only its prior CORS entry.
    [[ "$trimmed_origin" == "$old_monitor_url" && "$old_monitor_url" != "$monitor_url" ]] && continue
    if [[ "$trimmed_origin" == "$monitor_url" ]]; then
      monitor_present=true
    fi
    if [[ -n "$cors_origins" ]]; then cors_origins+=","; fi
    cors_origins+="$trimmed_origin"
  done
  if [[ "$monitor_present" == false ]]; then
    if [[ -n "$cors_origins" ]]; then cors_origins+=","; fi
    cors_origins+="$monitor_url"
  fi

  local tmp="${file}.tmp"
  sed -e '/^TWING_MONITOR_URL=/d' -e '/^TWING_SERVE_CORS_ORIGINS=/d' "$file" >"$tmp"
  printf 'TWING_MONITOR_URL=%s\nTWING_SERVE_CORS_ORIGINS=%s\n' "$monitor_url" "$cors_origins" >>"$tmp"
  mv "$tmp" "$file"
  chmod 600 "$file"
}

compose() {
  docker compose --project-directory "$install_dir" --env-file "$install_dir/.env" -f "$install_dir/compose.yaml" "$@"
}

pull_image() {
  local image="$1"
  if [[ "$pull" == true ]]; then
    echo "twing-server: pulling $image"
    docker pull "$image"
  else
    docker image inspect "$image" >/dev/null 2>&1 || die "image $image is not available locally"
  fi
}

wait_for_server() {
  compose up -d --wait --wait-timeout 90
}

show_status() {
  local env_file="$install_dir/.env"
  [[ -f "$env_file" ]] || die "no server installation at $install_dir"
  local transport domain bind port mode image scheme host
  transport="$(read_setting "$env_file" TWING_TRANSPORT)"
  [[ -n "$transport" ]] || transport="https"
  domain="$(read_setting "$env_file" TWING_SERVER_DOMAIN)"
  bind="$(read_setting "$env_file" TWING_BIND_ADDRESS)"
  port="$(read_setting "$env_file" TWING_PORT)"
  mode="$(read_setting "$env_file" TWING_AUTH_MODE)"
  image="$(read_setting "$env_file" TWING_SERVER_IMAGE)"
  compose ps
  scheme="$transport"
  host="$domain"
  if [[ "$transport" == "http" ]]; then host="$bind"; fi
  echo "twing-server: image=$image mode=$mode url=$scheme://$host:$port"
  compose exec -T server node -e \
    "fetch('http://127.0.0.1:8787/v1/version').then(async r=>{if(!r.ok)process.exit(1); console.log('twing-server: '+await r.text())}).catch(e=>{console.error(e.message);process.exit(1)})"
}

install_server() {
  local mode="auth" version="latest" image="" domain="" bind="0.0.0.0" port="443" http_port="80" transport="https" monitor_url="" port_set=false
  pull=true
  install_dir="$DEFAULT_INSTALL_DIR"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode) [[ $# -ge 2 ]] || die "--mode needs a value"; mode="$2"; shift 2 ;;
      --domain) [[ $# -ge 2 ]] || die "--domain needs a value"; domain="$2"; shift 2 ;;
      --insecure-http) transport="http"; shift ;;
      --version) [[ $# -ge 2 ]] || die "--version needs a value"; version="$2"; shift 2 ;;
      --image) [[ $# -ge 2 ]] || die "--image needs a value"; image="$2"; shift 2 ;;
      --dir) [[ $# -ge 2 ]] || die "--dir needs a value"; install_dir="$2"; shift 2 ;;
      --port) [[ $# -ge 2 ]] || die "--port needs a value"; port="$2"; port_set=true; shift 2 ;;
      --http-port) [[ $# -ge 2 ]] || die "--http-port needs a value"; http_port="$2"; shift 2 ;;
      --bind) [[ $# -ge 2 ]] || die "--bind needs a value"; bind="$2"; shift 2 ;;
      --monitor-url) [[ $# -ge 2 ]] || die "--monitor-url needs a value"; monitor_url="$2"; shift 2 ;;
      --no-pull) pull=false; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown install option: $1" ;;
    esac
  done

  [[ "$mode" == "auth" || "$mode" == "no-auth" ]] || die "--mode must be auth or no-auth"
  if [[ "$transport" == "https" ]]; then
    [[ "$domain" =~ ^[A-Za-z0-9.-]+$ ]] || die "--domain must be a hostname"
  else
    [[ -z "$domain" ]] || die "--domain and --insecure-http cannot be combined"
    [[ "$port_set" == true ]] || port="8787"
    [[ "$bind" != *$'\n'* && "$bind" != *$'\r'* ]] || die "invalid bind address"
  fi
  [[ "$port" =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) || die "--port must be between 1 and 65535"
  [[ "$http_port" =~ ^[0-9]+$ ]] && ((http_port >= 1 && http_port <= 65535)) || die "--http-port must be between 1 and 65535"
  [[ "$image" != *$'\n'* && "$image" != *$'\r'* ]] || die "invalid image reference"
  install_dir="$(absolute_path "$install_dir")"
  [[ ! -e "$install_dir/.env" ]] || die "$install_dir already contains a server installation; use upgrade"

  image="${image:-${DEFAULT_IMAGE_REPOSITORY}:${version}}"
  local runtime_mode="auth" project
  [[ "$mode" == "no-auth" ]] && runtime_mode="no_auth"
  project="twing-server-$(date -u +%Y%m%d%H%M%S)-$$"

  pull_image "$image"
  mkdir -p "$install_dir/data" "$install_dir/data/backups" "$install_dir/secrets"
  write_compose_file "$install_dir/compose.yaml" "$transport" "$bind" "$port" "$http_port"
  if [[ "$transport" == "https" ]]; then write_caddyfile "$install_dir/Caddyfile" "$domain"; fi
  write_server_env "$install_dir/server.env"
  [[ -z "$monitor_url" ]] || update_monitor_url "$install_dir/server.env" "$monitor_url"
  write_stack_env "$install_dir/.env" "$image" "$runtime_mode" "$transport" "$domain" "$bind" "$port" "$http_port" "$project"

  if ! wait_for_server; then
    compose logs --no-color >&2 || true
    die "server failed its startup health check"
  fi

  echo "twing-server: installed successfully"
  show_status
  if [[ "$mode" == "auth" ]]; then
    echo "twing-server: bootstrap token: $0 bootstrap-token --dir '$install_dir'"
  else
    echo "twing-server: no-auth mode trusts every client that can reach the configured server URL"
  fi
}

backup_database() {
  local stamp="$1"
  backup_name=""
  if compose exec -T server sh -c 'test -f /data/twing.db'; then
    backup_name="pre-upgrade-${stamp}.db"
    compose exec -T server mkdir -p /data/backups
    compose exec -T server sqlite3 /data/twing.db ".backup /data/backups/$backup_name"
    echo "twing-server: database backup: $install_dir/data/backups/$backup_name"
  fi
}

restore_database() {
  local old_image="$1" stamp="$2"
  [[ -n "$backup_name" ]] || return 0
  docker run --rm -v "$install_dir/data:/data" --entrypoint sh "$old_image" -c '
    backup="$1"
    stamp="$2"
    test -f "/data/backups/$backup" || exit 1
    if test -f /data/twing.db; then mv /data/twing.db "/data/failed-upgrade-${stamp}.db"; fi
    rm -f /data/twing.db-wal /data/twing.db-shm
    cp "/data/backups/$backup" /data/twing.db
  ' sh "$backup_name" "$stamp"
}

upgrade_server() {
  local version="latest" image="" monitor_url=""
  pull=true
  install_dir="$DEFAULT_INSTALL_DIR"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version) [[ $# -ge 2 ]] || die "--version needs a value"; version="$2"; shift 2 ;;
      --image) [[ $# -ge 2 ]] || die "--image needs a value"; image="$2"; shift 2 ;;
      --dir) [[ $# -ge 2 ]] || die "--dir needs a value"; install_dir="$2"; shift 2 ;;
      --monitor-url) [[ $# -ge 2 ]] || die "--monitor-url needs a value"; monitor_url="$2"; shift 2 ;;
      --no-pull) pull=false; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown upgrade option: $1" ;;
    esac
  done

  install_dir="$(absolute_path "$install_dir")"
  local env_file="$install_dir/.env"
  [[ -f "$env_file" && -f "$install_dir/compose.yaml" ]] || die "no server installation at $install_dir"

  local old_image new_image mode transport domain bind port http_port project stamp
  old_image="$(read_setting "$env_file" TWING_SERVER_IMAGE)"
  mode="$(read_setting "$env_file" TWING_AUTH_MODE)"
  transport="$(read_setting "$env_file" TWING_TRANSPORT)"
  [[ -n "$transport" ]] || transport="https"
  domain="$(read_setting "$env_file" TWING_SERVER_DOMAIN)"
  bind="$(read_setting "$env_file" TWING_BIND_ADDRESS)"
  port="$(read_setting "$env_file" TWING_PORT)"
  http_port="$(read_setting "$env_file" TWING_HTTP_PORT)"
  project="$(read_setting "$env_file" TWING_COMPOSE_PROJECT)"
  new_image="${image:-${DEFAULT_IMAGE_REPOSITORY}:${version}}"
  [[ "$new_image" != *$'\n'* && "$new_image" != *$'\r'* ]] || die "invalid image reference"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"

  pull_image "$new_image"
  backup_database "$stamp"
  write_compose_file "$install_dir/compose.yaml" "$transport" "$bind" "$port" "$http_port"
  if [[ "$transport" == "https" ]]; then write_caddyfile "$install_dir/Caddyfile" "$domain"; fi
  [[ -z "$monitor_url" ]] || update_monitor_url "$install_dir/server.env" "$monitor_url"
  write_stack_env "$env_file" "$new_image" "$mode" "$transport" "$domain" "$bind" "$port" "$http_port" "$project"

  if wait_for_server; then
    echo "twing-server: upgraded $old_image -> $new_image"
    show_status
    return 0
  fi

  echo "twing-server: upgrade failed; restoring $old_image" >&2
  compose logs --no-color >&2 || true
  compose down >/dev/null 2>&1 || true
  restore_database "$old_image" "$stamp" || echo "twing-server: WARNING: automatic database restore failed; backup remains at $install_dir/data/backups/$backup_name" >&2
  write_stack_env "$env_file" "$old_image" "$mode" "$transport" "$domain" "$bind" "$port" "$http_port" "$project"
  wait_for_server || die "upgrade and automatic rollback both failed"
  die "upgrade failed; the previous server and database were restored"
}

simple_dir_option() {
  install_dir="$DEFAULT_INSTALL_DIR"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) [[ $# -ge 2 ]] || die "--dir needs a value"; install_dir="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  install_dir="$(absolute_path "$install_dir")"
  [[ -f "$install_dir/.env" ]] || die "no server installation at $install_dir"
}

owned_installation() {
  local env_file="$install_dir/.env" compose_file="$install_dir/compose.yaml"
  [[ -f "$env_file" && -f "$compose_file" ]] || return 1
  [[ "$(read_setting "$env_file" TWING_COMPOSE_PROJECT)" =~ ^twing-server-[0-9]{14}-[0-9]+$ ]] || return 1
  [[ -n "$(read_setting "$env_file" TWING_SERVER_IMAGE)" ]] || return 1
  [[ "$(read_setting "$env_file" TWING_AUTH_MODE)" =~ ^(auth|no_auth)$ ]] || return 1
  [[ "$(read_setting "$env_file" TWING_TRANSPORT)" =~ ^(https|http)$ ]] || return 1
  grep -Fqx 'name: ${TWING_COMPOSE_PROJECT}' "$compose_file" || return 1
  grep -Fqx '      - ./data:/data' "$compose_file" || return 1
}

remove_managed_directory() {
  local dir="$1"
  [[ ! -L "$dir" ]] || die "refusing to remove symlink $dir"
  [[ -d "$dir" ]] || return 0
  rm -rf "$dir"
}

uninstall_server() {
  local purge_data=false
  install_dir="$DEFAULT_INSTALL_DIR"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) [[ $# -ge 2 ]] || die "--dir needs a value"; install_dir="$2"; shift 2 ;;
      --purge-data) purge_data=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown uninstall option: $1" ;;
    esac
  done

  install_dir="$(absolute_path "$install_dir")"
  owned_installation || die "refusing to uninstall $install_dir: not a twing server installation"
  [[ ! -L "$install_dir/data" && -d "$install_dir/data" ]] || die "refusing to remove unsafe data path $install_dir/data"

  compose down --volumes --remove-orphans
  rm -f "$install_dir/twing-server" "$install_dir/.env" "$install_dir/compose.yaml" "$install_dir/Caddyfile" "$install_dir/server.env"
  remove_managed_directory "$install_dir/secrets"

  if [[ "$purge_data" == true ]]; then
    remove_managed_directory "$install_dir/data"
    rmdir "$install_dir" 2>/dev/null || true
    echo "twing-server: uninstalled and removed persistent data"
  else
    echo "twing-server: uninstalled; persistent data remains at $install_dir/data"
    echo "twing-server: reinstall with --dir '$install_dir' to reuse it, or remove it with uninstall --purge-data"
  fi
}

command -v docker >/dev/null 2>&1 || die "docker is required"
docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"

command="${1:-}"
[[ -n "$command" ]] || { usage; exit 1; }
shift || true

case "$command" in
  install) install_server "$@" ;;
  upgrade) upgrade_server "$@" ;;
  status) simple_dir_option "$@"; show_status ;;
  bootstrap-token) simple_dir_option "$@"; compose exec -T server cat /data/bootstrap-token ;;
  stop) simple_dir_option "$@"; compose down ;;
  uninstall) uninstall_server "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $command" ;;
esac
